# Diagnostic variant: same reproducer, run under valgrind/memcheck so an
# invalid write or bad free inside the profiler is reported at the moment it
# happens instead of crashing later somewhere unrelated.
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends valgrind gdb procps \
 && rm -rf /var/lib/apt/lists/*

ARG PYROSCOPE_VERSION=1.2.1
RUN pip install --no-cache-dir "pyroscope-io==${PYROSCOPE_VERSION}" gunicorn

WORKDIR /app
COPY sink.py workload.py wsgi.py gunicorn_conf.py runner.py forkload.py ./

# PYTHONMALLOC=malloc keeps memcheck from drowning in pymalloc noise.
ENV PYTHONUNBUFFERED=1 \
    PYTHONMALLOC=malloc \
    PYROSCOPE_SERVER=http://127.0.0.1:4040 \
    SAMPLE_RATE=100 \
    THREADS=4 \
    DEPTH=20

COPY run-valgrind.sh /usr/local/bin/run-valgrind.sh
ENTRYPOINT ["/usr/local/bin/run-valgrind.sh"]
