set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(LINUX_SYSROOT "$ENV{HOME}/OrbStack/ubuntu" CACHE PATH "Linux sysroot, e.g. an OrbStack machine root")
set(LINUX_TARGET aarch64-linux-gnu)

set(CMAKE_SYSROOT ${LINUX_SYSROOT})
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET ${LINUX_TARGET})
set(CMAKE_CXX_COMPILER_TARGET ${LINUX_TARGET})

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_FIND_ROOT_PATH ${LINUX_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_SIZEOF_VOID_P 8)
set(CMAKE_LIBRARY_ARCHITECTURE ${LINUX_TARGET})

set(Python3_INCLUDE_DIR ${LINUX_SYSROOT}/usr/include/python3.12 CACHE PATH "")
set(Python3_LIBRARY ${LINUX_SYSROOT}/usr/lib/${LINUX_TARGET}/libpython3.12.so CACHE FILEPATH "")
